{
  "name": "wanxiang",
  "version": "0.1.4",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "productName": "万象工坊",
  "description": "万象工坊 · 本地小说与原创人物资料库",
  "main": "dist-desktop/electron/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.desktop.json --noEmit",
    "build:skills": "node scripts/build-skills.mjs",
    "build:desktop": "node scripts/build-api-contract.mjs && node scripts/build-skills.mjs && tsc -p tsconfig.desktop.json",
    "build": "pnpm run typecheck && pnpm run build:desktop && vite build",
    "start": "node scripts/start.mjs",
    "package:windows": "pnpm build && node scripts/package-windows.mjs",
    "package:mac": "pnpm build && node scripts/package-unix.mjs mac",
    "package:linux": "pnpm build && node scripts/package-unix.mjs linux",
    "release:collect": "node scripts/collect-release.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "13.0.3",
    "electron-updater": "^6.8.11",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
