import { contextBridge, ipcRenderer } from 'electron';
import type { DesktopApi, CharacterInput } from '../src/shared/types.ts';

let generation:string|undefined;
const content=async(channel:string,...args:unknown[])=>{
  const result=await ipcRenderer.invoke(channel,{args,generation});
  if(channel==='library:snapshot'&&result.ok&&generation===undefined)generation=result.value.generation;
  return result;
};
const api: DesktopApi = {
  saveLibraryConfig:i=>content('library:config',i),
  saveCatalogLink:i=>content('catalog:save-link',i),
  savePlace:i=>content('place:save',i),archivePlace:(...a)=>content('place:archive',...a),
  saveTechnique:i=>content('technique:save',i),archiveTechnique:(...a)=>content('technique:archive',...a),
  saveItem:i=>content('item:save',i),archiveItem:(...a)=>content('item:archive',...a),
  exportTransfer:input=>content('transfer:export',input),
  previewTransferImport:input=>content('transfer:preview',input),
  importTransfer:input=>content('transfer:import',input),
  cancelTransferImport:input=>content('transfer:cancel',input),
  pickTransferFile:()=>ipcRenderer.invoke('transfer:pick-file'),
  saveTransferFile:input=>ipcRenderer.invoke('transfer:save-file',input),
  listHistory:input=>content('history:list',input),
  getHistory:input=>content('history:detail',input),
  previewHistoryRestore:input=>content('history:preview',input),
  restoreHistory:input=>content('history:restore',input),
  getDesktopStatus:()=>ipcRenderer.invoke('desktop:status'),
  openDataDirectory:()=>ipcRenderer.invoke('desktop:data-directory'),
  completeOnboarding:()=>ipcRenderer.invoke('desktop:onboarding-complete'),
  setLoginAtStartup:enabled=>ipcRenderer.invoke('desktop:login-at-startup',enabled),
  setCloseToTray:enabled=>ipcRenderer.invoke('desktop:close-to-tray',enabled),
  hideToTray:()=>ipcRenderer.invoke('desktop:hide'),
  quitApplication:()=>ipcRenderer.invoke('desktop:quit'),
  getUpdateStatus:()=>ipcRenderer.invoke('update:status'),
  getUpdateCache:()=>ipcRenderer.invoke('update:cache'),
  clearUpdateCache:()=>ipcRenderer.invoke('update:clear-cache'),
  saveUpdateSettings:input=>ipcRenderer.invoke('update:settings',input),
  checkForUpdates:()=>ipcRenderer.invoke('update:check'),
  downloadUpdate:()=>ipcRenderer.invoke('update:download'),
  installUpdate:()=>ipcRenderer.invoke('update:install'),
  openUpgradeRecovery:()=>ipcRenderer.invoke('update:recovery-folder'),
  getBackupStatus:()=>ipcRenderer.invoke('backup:status'),
  saveBackupSettings:input=>ipcRenderer.invoke('backup:settings',input),
  estimateBackup:()=>ipcRenderer.invoke('backup:estimate'),
  createBackupBaseline:input=>ipcRenderer.invoke('backup:baseline',input),
  runIncrementalBackup:()=>ipcRenderer.invoke('backup:increment'),
  previewBackupRestore:id=>ipcRenderer.invoke('backup:preview',id),
  restoreBackup:token=>ipcRenderer.invoke('backup:restore',token),
  deleteBackupPoint:id=>ipcRenderer.invoke('backup:delete',id),
  pickBackupDirectory:()=>ipcRenderer.invoke('backup:directory'),
  getConnectionInfo:()=>ipcRenderer.invoke('connection:info'),
  setLanEnabled:enabled=>ipcRenderer.invoke('connection:lan',enabled),
  setBrowserAccessMode:mode=>ipcRenderer.invoke('connection:browser-mode',mode),
  clearBrowserSessions:()=>ipcRenderer.invoke('connection:clear-sessions'),
  createConnectionPairing:()=>ipcRenderer.invoke('connection:pairing'),
  getMcpConfig:()=>ipcRenderer.invoke('connection:mcp-config'),
  rotateConnectionCredentials:()=>ipcRenderer.invoke('connection:rotate'),
  getRevision:()=>ipcRenderer.invoke('connection:revision'),
  openWeb:()=>ipcRenderer.invoke('connection:open'),
  downloadSkill:kind=>ipcRenderer.invoke('connection:download-skill',kind),
  createWork:input=>content('work:create',input),
  saveWork:input=>content('work:save',input),
  previewDeletion:input=>content('content:preview-deletion',input),
  deleteContent:input=>content('content:delete',input),
  archiveWork:(id,version,archived)=>content('work:archive',id,version,archived),
  saveWorld:input=>content('world:save',input),
  selectWork:id=>content('work:select',id),
  snapshot: () => content('library:snapshot'),
  saveCharacter: (input: CharacterInput) => content('character:save',input),
  archiveCharacter: (id,version,archived) => content('character:archive',id,version,archived),
  pickPortrait: worldId => ipcRenderer.invoke('portrait:pick',worldId,generation),
  saveTag: input => content('tag:save',input),
  deleteTag: (id,version) => content('tag:delete',id,version),
  setThemePreferences: patch => content('theme:preferences',patch),
  setTheme: theme => content('theme:set',theme),
  saveAttributeTemplate: input => content('attribute-template:save',input),
  saveCharacterVariants: input => content('character:variants',input),
  saveCharacterStage: input => content('character:stage',input),
  reorderCharacterStages: (id,version,ids) => content('character:stage-order',id,version,ids),
  saveRelationType: input=>content('relation-type:save',input),
  saveRelation: input=>content('relation:save',input),
  archiveRelation:(id,version,archived)=>content('relation:archive',id,version,archived),
  saveGraphLayout:input=>content('graph:layout',input),
  saveWorldCategory:input=>content('world-category:save',input),
  saveWorldEntry:input=>content('world-entry:save',input),
  archiveWorldEntry:(id,version,archived)=>content('world-entry:archive',id,version,archived),
  pickWorldImage:worldId=>ipcRenderer.invoke('world-image:pick',worldId,generation),
  saveMap:input=>content('map:save',input),
  importMedia:worldId=>ipcRenderer.invoke('media:import',worldId,generation),
  saveMedia:input=>content('media:save',input),
  archiveMedia:(id,version,archived)=>content('media:archive',id,version,archived),
  saveMediaCatalog:input=>content('media:catalog',input),
  saveDashboard:input=>content('dashboard:save',input),
  saveOutline:input=>content('outline:save',input),
  saveChapter:input=>content('chapter:save',input),
  archiveChapter:(id,version,archived)=>content('chapter:archive',id,version,archived),
  saveTimeline:input=>content('timeline:save',input),
  archiveTimeline:(id,version,archived)=>content('timeline:archive',id,version,archived),
  archiveMap:(id,version,archived)=>content('map:archive',id,version,archived),
  pickMapImage:worldId=>ipcRenderer.invoke('map-image:pick',worldId,generation)
};
contextBridge.exposeInMainWorld('studio',api);
