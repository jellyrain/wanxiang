; Delete only files that shipped in this version; preserve $INSTDIR\data on both
; upgrade and uninstall. Generated by afterPack before NSIS compilation.
!include "${BUILD_RESOURCES_DIR}\remove-program-files.nsh"
; Only remove this installation's startup command during a real uninstall.
!macro customUnInstall
  ${ifNot} ${isUpdated}
    ReadRegStr $R0 HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "WanxiangWorkshop"
    StrCmp $R0 '$\"$INSTDIR\${APP_EXECUTABLE_FILENAME}$\" --background' 0 +2
      DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "WanxiangWorkshop"
  ${endIf}
!macroend
